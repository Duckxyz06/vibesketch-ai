# Gemini API Key — BẮT BUỘC
# Lấy tại: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# (Tuỳ chọn) URL của app khi deploy
APP_URL=http://localhost:5173
